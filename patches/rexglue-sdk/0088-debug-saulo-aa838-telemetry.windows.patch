+void D3D12CommandProcessor::DebugSauloAa838CaptureGuestState(Aa838DrawRecord& record,
+                                                             const D3D12Shader& pixel_shader,
+                                                             xenos::PrimitiveType primitive_type,
+                                                             uint32_t index_count) const {
+  const RegisterFile& regs = *register_file_;
+  auto surface_info = regs.Get<reg::RB_SURFACE_INFO>();
+  auto color_info = regs.Get<reg::RB_COLOR_INFO>();
+  auto depth_info = regs.Get<reg::RB_DEPTH_INFO>();
+  record.frame = frame_current_;
+  record.ps_hash = pixel_shader.ucode_data_hash();
+  record.rov = render_target_cache_->GetPath() == RenderTargetCache::Path::kPixelShaderInterlock;
+  record.guest_msaa_samples = UINT32_C(1) << uint32_t(surface_info.msaa_samples);
+  record.host_msaa_samples = record.rov ? 1
+                             : (surface_info.msaa_samples == xenos::MsaaSamples::k2X &&
+                                !render_target_cache_->msaa_2x_supported())
+                                 ? 4
+                                 : record.guest_msaa_samples;
+  record.resolution_scale_x = texture_cache_->draw_resolution_scale_x();
+  record.resolution_scale_y = texture_cache_->draw_resolution_scale_y();
+  record.color_base = color_info.value & 0xFFF;
+  record.color_format = uint32_t(color_info.color_format);
+  record.depth_base = depth_info.value & 0xFFF;
+  record.depth_format = uint32_t(depth_info.depth_format);
+  record.surface_pitch = surface_info.surface_pitch;
+  record.color_mask = regs[XE_GPU_REG_RB_COLOR_MASK];
+  record.blend_control = regs[XE_GPU_REG_RB_BLENDCONTROL0];
+  record.depth_control = regs[XE_GPU_REG_RB_DEPTHCONTROL];
+  record.stencil_ref_mask = regs[XE_GPU_REG_RB_STENCILREFMASK];
+  record.stencil_ref_mask_bf = regs[XE_GPU_REG_RB_STENCILREFMASK_BF];
+  record.guest_bool = (regs[XE_GPU_REG_SHADER_CONSTANT_BOOL_000_031 +
+                            (kAa838StageAByte1ZeroBool >> 5)] >>
+                       (kAa838StageAByte1ZeroBool & 31)) &
+                      1;
+  if (!pixel_shader.texture_bindings().empty()) {
+    uint32_t fetch_index = pixel_shader.texture_bindings().front().fetch_constant;
+    xenos::xe_gpu_texture_fetch_t fetch = regs.GetTextureFetch(fetch_index);
+    record.source_fetch = fetch_index;
+    record.source_address = fetch.base_address << 12;
+    record.source_format = uint32_t(fetch.format);
+    record.source_width = fetch.size_2d.width + 1;
+    record.source_height = fetch.size_2d.height + 1;
+  }
+  record.primitive_type = uint32_t(primitive_type);
+  record.index_count = index_count;
+}
