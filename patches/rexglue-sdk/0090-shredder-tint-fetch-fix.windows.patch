@@ -0,0 +1,38 @@
+/**
+ * @modified    Tom Clay, 2026 - Adapted for ReXGlue runtime
+ */
+
+#pragma once
+
+#include <cstdint>
+
+namespace rex::graphics::d3d12 {
+
+// The final-boss mesh switches its tint fetch (vf94) between a constant read (another vertex shader) and a
+// per-vertex read from a binding that holds a single dword, so every vertex past the first reads past the
+// binding and the albedo can turn black. While the binding is that single dword, every vertex reads element 0.
+constexpr uint64_t kShredderTintVertexShader = 0x703F5C625425CE6Dull;
+constexpr uint64_t kShredderTintPixelShader = 0x47184C4711FA376Bull;
+constexpr uint32_t kShredderTintFetchConstant = 94;
+constexpr uint32_t kShredderTintFetchDwords = 1;
+// A bool constant no game shader reads; carries the per-draw decision into the vertex shader.
+constexpr uint32_t kShredderTintFixBool = 121;
+
+inline bool ShredderTintFixMatchesFetch(uint64_t vertex_shader_hash, uint32_t fetch_constant,
+                                        bool is_mini_fetch, uint32_t stride_dwords) {
+  return vertex_shader_hash == kShredderTintVertexShader && fetch_constant == kShredderTintFetchConstant &&
+         !is_mini_fetch && stride_dwords != 0;
+}
+
+inline bool ShredderTintFixMatchesDraw(uint64_t vertex_shader_hash, uint64_t pixel_shader_hash,
+                                       bool fetch_is_vertex, uint32_t fetch_dwords) {
+  return vertex_shader_hash == kShredderTintVertexShader && pixel_shader_hash == kShredderTintPixelShader &&
+         fetch_is_vertex && fetch_dwords == kShredderTintFetchDwords;
+}
+
+inline uint32_t ShredderTintFetchAddress(uint32_t base_bytes, uint32_t index, uint32_t stride_dwords,
+                                         bool fix_active) {
+  return fix_active ? base_bytes : base_bytes + index * stride_dwords * 4;
+}
+
+}  // namespace rex::graphics::d3d12
