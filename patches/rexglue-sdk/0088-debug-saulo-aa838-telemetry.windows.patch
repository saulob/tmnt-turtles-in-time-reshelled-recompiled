+/**
+ * @modified    Tom Clay, 2026 - Adapted for ReXGlue runtime
+ */
+
+// DEBUG_SAULO: temporary AA838 Stage A telemetry for GitHub issue #2. Remove with the
+// investigation.
+
+#pragma once
+
+#include <cinttypes>
+#include <cstdint>
+#include <cstdio>
+#include <functional>
+#include <map>
+#include <mutex>
+#include <string>
+#include <utility>
+#include <vector>
+
+namespace rex::graphics::d3d12 {
+
+struct Aa838DeviceInfo {
+  uint32_t vendor_id = 0;
+  uint32_t device_id = 0;
+  uint64_t driver_version = 0;
+  uint32_t tiled_resources_tier = 0;
+  bool unaligned_bc = false;
+  uint32_t sample_positions_tier = 0;
+  bool rov_supported = false;
+  bool bindless = false;
+  bool rov = false;
+  bool native_2x_msaa = false;
+  bool host_2x = false;
+  // Formats: RGBA8, RGB10A2, D24S8, D32S8, R32_UINT.
+  uint32_t quality_2x[5] = {};
+  uint32_t quality_4x[5] = {};
+  uint32_t resolution_scale_x = 1;
+  uint32_t resolution_scale_y = 1;
+  bool async_shader_compilation = false;
+  bool depth_f24_in_ps = false;
+  bool depth_f24_round = false;
+  uint32_t stage_a_bool = 0;
+  uint64_t stage_a_ps = 0;
+};
+
+struct Aa838DrawRecord {
+  enum class Reached : uint8_t {
+    kCounted,
+    kPrimitives,
+    kRenderTargets,
+    kPipeline,
+    kBindings,
+    kDraw
+  };
+
+  uint64_t frame = 0;
+  uint64_t ps_hash = 0;
+  uint64_t ps_modification = 0;
+  Reached reached = Reached::kCounted;
+  bool stage_a_requested = false;
+  bool bool_bound = false;
+  bool guest_bool = false;
+  bool rov = false;
+  uint32_t guest_msaa_samples = 1;
+  uint32_t host_msaa_samples = 1;
+  uint32_t resolution_scale_x = 1;
+  uint32_t resolution_scale_y = 1;
+  uint32_t color_base = 0;
+  uint32_t color_format = 0;
+  uint32_t depth_base = 0;
+  uint32_t depth_format = 0;
+  uint32_t surface_pitch = 0;
+  uint32_t host_rt_bits = 0;
+  uint32_t host_rt0_format = 0;
+  uint32_t host_depth_format = 0;
+  uint32_t color_mask = 0;
+  uint32_t blend_control = 0;
+  uint32_t depth_control = 0;
+  uint32_t stencil_ref_mask = 0;
+  uint32_t stencil_ref_mask_bf = 0;
+  uint32_t viewport[4] = {};
+  uint32_t scissor[4] = {};
+  uint32_t source_fetch = UINT32_MAX;
+  uint32_t source_address = 0;
+  uint32_t source_format = 0;
+  uint32_t source_width = 0;
+  uint32_t source_height = 0;
+  uint32_t primitive_type = 0;
+  uint32_t index_count = 0;
+};
+
+class DebugSauloAa838Telemetry {
+ public:
+  using Sink = std::function<void(const std::string&)>;
+
+  static constexpr uint32_t kExpectedDrawsPerFrame = 3;
+  static constexpr uint32_t kMaxDrawLinesPerFrame = 8;
+  static constexpr uint32_t kFirstFramesLogged = 4;
+  static constexpr uint32_t kMaxNewSignatureFrames = 48;
+  static constexpr uint32_t kMaxAnomalyLines = 64;
+  static constexpr uint32_t kMaxAnomalyLinesPerKind = 8;
+  static constexpr uint32_t kMaxAnomalyFrames = 16;
+  static constexpr uint32_t kPeriodicFrameInterval = 1800;
+  static constexpr uint32_t kMaxPeriodicFrames = 24;
+  static constexpr uint32_t kMaxSummaries = 40;
+  static constexpr uint32_t kMaxTranslationLines = 16;
+  static constexpr size_t kMaxSignatures = 96;
+
+  explicit DebugSauloAa838Telemetry(Sink sink) : sink_(std::move(sink)) {}
+
+  static const char* StageName(uint32_t ordinal) {
+    static const char* const kNames[] = {"A", "B", "C"};
+    return ordinal < 3 ? kNames[ordinal] : "extra";
+  }
+
+  static const char* ReachedName(Aa838DrawRecord::Reached reached) {
+    switch (reached) {
+      case Aa838DrawRecord::Reached::kCounted:
+        return "counted";
+      case Aa838DrawRecord::Reached::kPrimitives:
+        return "primitives";
+      case Aa838DrawRecord::Reached::kRenderTargets:
+        return "render_targets";
+      case Aa838DrawRecord::Reached::kPipeline:
+        return "pipeline";
+      case Aa838DrawRecord::Reached::kBindings:
+        return "bindings";
+      case Aa838DrawRecord::Reached::kDraw:
+        return "draw";
+    }
+    return "?";
+  }
+
+  // Once per process; later calls (another GPU context) are ignored.
+  void LogDevice(const Aa838DeviceInfo& d) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (device_logged_) {
+      return;
+    }
+    device_logged_ = true;
+    const char* guest_2x = d.rov ? "rov" : (d.host_2x ? "host2x" : "host4x_samples0+3_mask0x9");
+    Emit(Format(
+        "DEBUG_SAULO AA838 device vendor=0x%04X device=0x%04X driver=%u.%u.%u.%u tiled_tier=%u"
+        " unaligned_bc=%d sample_positions_tier=%u rov_supported=%d bindless=%d rt_path=%s"
+        " native_2x_msaa=%d host_2x=%d guest2x_on=%s sample_positions=driver_default"
+        " sample_quality=0 q2x=[rgba8:%u rgb10a2:%u d24s8:%u d32s8:%u r32u:%u]"
+        " q4x=[rgba8:%u rgb10a2:%u d24s8:%u d32s8:%u r32u:%u] scale=%ux%u"
+        " async_shader_compilation=%d depth_f24_in_ps=%d depth_f24_round=%d stage_a_bool=%u"
+        " stage_a_ps=%016" PRIX64,
+        d.vendor_id, d.device_id, uint32_t(d.driver_version >> 48),
+        uint32_t(d.driver_version >> 32) & 0xFFFF, uint32_t(d.driver_version >> 16) & 0xFFFF,
+        uint32_t(d.driver_version) & 0xFFFF, d.tiled_resources_tier, int(d.unaligned_bc),
+        d.sample_positions_tier, int(d.rov_supported), int(d.bindless), d.rov ? "rov" : "rtv",
+        int(d.native_2x_msaa), int(d.host_2x), guest_2x, d.quality_2x[0], d.quality_2x[1],
+        d.quality_2x[2], d.quality_2x[3], d.quality_2x[4], d.quality_4x[0], d.quality_4x[1],
+        d.quality_4x[2], d.quality_4x[3], d.quality_4x[4], d.resolution_scale_x,
+        d.resolution_scale_y, int(d.async_shader_compilation), int(d.depth_f24_in_ps),
+        int(d.depth_f24_round), d.stage_a_bool, d.stage_a_ps));
+  }
+
+  void OnTranslation(uint64_t modification, bool rov, bool fix_emitted) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    translations_[modification] = fix_emitted;
+    ++translation_count_;
+    if (!fix_emitted) {
+      ++translations_without_fix_;
+    }
+    if (translation_lines_ < kMaxTranslationLines) {
+      ++translation_lines_;
+      Emit(Format("DEBUG_SAULO AA838 translate mod=%016" PRIX64 " rov=%d fix_compiled=%d",
+                  modification, int(rov), int(fix_emitted)));
+    }
+    if (!fix_emitted) {
+      Anomaly(0, "fix_not_compiled", "mod=%016" PRIX64 " rov=%d", modification, int(rov));
+    }
+  }
+
+  // Call for every draw whose pixel shader is AA838, in draw order, once it has returned or drawn.
+  void OnDraw(const Aa838DrawRecord& record) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    uint32_t ordinal = frame_draws_++;
+    ++total_draws_;
+    bool drawn = record.reached == Aa838DrawRecord::Reached::kDraw;
+    if (record.stage_a_requested) {
+      ++stage_a_requested_;
+      if (frame_stage_a_++) {
+        FrameAnomaly(record.frame, "two_stage_a", "ordinal=%u", ordinal);
+      }
+    }
+    if (record.stage_a_requested != (ordinal == 0)) {
+      FrameAnomaly(record.frame, "classifier_mismatch", "ordinal=%u requested=%d", ordinal,
+                   int(record.stage_a_requested));
+    }
+    if (ordinal >= kExpectedDrawsPerFrame) {
+      FrameAnomaly(record.frame, "extra_draw", "ordinal=%u", ordinal);
+    }
+    if (!drawn) {
+      ++dropped_draws_;
+      FrameAnomaly(record.frame, "draw_dropped", "ordinal=%u reached=%s", ordinal,
+                   ReachedName(record.reached));
+    } else {
+      if (record.stage_a_requested && record.bool_bound) {
+        ++stage_a_bound_;
+      }
+      if (record.stage_a_requested && !record.bool_bound) {
+        FrameAnomaly(record.frame, "stage_a_bool_not_uploaded", "ordinal=%u", ordinal);
+      }
+      if (!record.stage_a_requested && record.bool_bound) {
+        FrameAnomaly(record.frame, "bool_set_outside_stage_a", "ordinal=%u guest_bool=%d", ordinal,
+                     int(record.guest_bool));
+      }
+      int fix_compiled = FixCompiled(record.ps_modification);
+      if (fix_compiled == 0) {
+        FrameAnomaly(record.frame, "drawn_without_fix", "ordinal=%u mod=%016" PRIX64, ordinal,
+                     record.ps_modification);
+      }
+    }
+    MixSignature(ordinal, record);
+    if (frame_records_.size() < kMaxDrawLinesPerFrame) {
+      frame_records_.emplace_back(ordinal, record);
+    }
+  }
+
+  void OnFrameEnd(uint64_t frame) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    ++frames_;
+    uint32_t count = frame_draws_;
+    ++draws_per_frame_[count < 5 ? count : 5];
+    if (count && count != kExpectedDrawsPerFrame) {
+      FrameAnomaly(frame, "draw_count", "draws=%u expected=%u", count, kExpectedDrawsPerFrame);
+    }
+    if (count) {
+      ++aa838_frames_;
+      const char* reason = SequenceReason();
+      if (reason) {
+        Emit(Format("DEBUG_SAULO AA838 sequence frame=%" PRIu64 " draws=%u reason=%s", frame, count,
+                    reason));
+        for (const auto& [ordinal, record] : frame_records_) {
+          Emit(DrawLine(ordinal, record));
+        }
+      }
+    }
+    if (frames_ % kPeriodicFrameInterval == 0) {
+      Summary("periodic");
+    }
+    frame_draws_ = 0;
+    frame_stage_a_ = 0;
+    frame_anomaly_ = false;
+    frame_signature_ = kFnvOffset;
+    frame_records_.clear();
+  }
+
+  void Flush(const char* reason) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (!flushed_) {
+      flushed_ = true;
+      Summary(reason, true);
+    }
+  }
+
+  uint64_t lines_emitted() const {
+    std::lock_guard<std::mutex> lock(mutex_);
+    return lines_emitted_;
+  }
+
+ private:
+  static constexpr uint64_t kFnvOffset = 0xCBF29CE484222325ull;
+
+  template <typename... Args>
+  static std::string Format(const char* format, Args... args) {
+    char buffer[768];
+    int length = std::snprintf(buffer, sizeof(buffer), format, args...);
+    if (length < 0) {
+      return {};
+    }
+    return std::string(buffer,
+                       size_t(length) < sizeof(buffer) ? size_t(length) : sizeof(buffer) - 1);
+  }
+
+  void Emit(const std::string& line) {
+    ++lines_emitted_;
+    if (sink_) {
+      sink_(line);
+    }
+  }
+
+  int FixCompiled(uint64_t modification) const {
+    auto it = translations_.find(modification);
+    return it == translations_.end() ? -1 : int(it->second);
+  }
+
+  // kind must be a string literal: the per-kind cap is keyed by its address.
+  template <typename... Args>
+  void Anomaly(uint64_t frame, const char* kind, const char* detail_format, Args... args) {
+    ++anomalies_;
+    uint32_t& kind_lines = anomaly_kind_lines_[kind];
+    if (anomaly_lines_ < kMaxAnomalyLines && kind_lines < kMaxAnomalyLinesPerKind) {
+      ++anomaly_lines_;
+      ++kind_lines;
+      Emit(Format("DEBUG_SAULO AA838 anomaly frame=%" PRIu64 " kind=%s %s", frame, kind,
+                  Format(detail_format, args...).c_str()));
+    }
+  }
+
+  template <typename... Args>
+  void FrameAnomaly(uint64_t frame, const char* kind, const char* detail_format, Args... args) {
+    frame_anomaly_ = true;
+    Anomaly(frame, kind, detail_format, args...);
+  }
+
+  void MixSignature(uint32_t ordinal, const Aa838DrawRecord& r) {
+    const uint64_t values[] = {
+        ordinal,
+        r.ps_modification,
+        uint64_t(r.reached),
+        r.stage_a_requested,
+        r.bool_bound,
+        r.guest_msaa_samples,
+        r.host_msaa_samples,
+        r.color_base,
+        r.color_format,
+        r.depth_base,
+        r.depth_format,
+        r.surface_pitch,
+        r.host_rt_bits,
+        r.color_mask,
+        r.blend_control,
+        r.depth_control,
+        r.stencil_ref_mask,
+        r.stencil_ref_mask_bf,
+        r.viewport[0],
+        r.viewport[1],
+        r.viewport[2],
+        r.viewport[3],
+        r.scissor[0],
+        r.scissor[1],
+        r.scissor[2],
+        r.scissor[3],
+        r.source_format,
+        r.source_width,
+        r.source_height,
+        r.primitive_type,
+        r.index_count,
+    };
+    for (uint64_t value : values) {
+      frame_signature_ = (frame_signature_ ^ value) * 0x100000001B3ull;
+    }
+  }
+
+  bool RememberSignature() {
+    for (uint64_t signature : signatures_) {
+      if (signature == frame_signature_) {
+        return false;
+      }
+    }
+    if (signatures_.size() >= kMaxSignatures) {
+      return false;
+    }
+    signatures_.push_back(frame_signature_);
+    return true;
+  }
+
+  const char* SequenceReason() {
+    bool new_state = RememberSignature();
+    if (aa838_frames_ <= kFirstFramesLogged) {
+      return "first";
+    }
+    if (frame_anomaly_ && anomaly_frames_logged_ < kMaxAnomalyFrames) {
+      ++anomaly_frames_logged_;
+      return "anomaly";
+    }
+    if (new_state && new_signature_frames_ < kMaxNewSignatureFrames) {
+      ++new_signature_frames_;
+      return "new_state";
+    }
+    if (aa838_frames_ % kPeriodicFrameInterval == 0 && periodic_frames_ < kMaxPeriodicFrames) {
+      ++periodic_frames_;
+      return "periodic";
+    }
+    return nullptr;
+  }
+
+  void Summary(const char* reason, bool final_summary = false) {
+    if (summaries_ >= kMaxSummaries && !final_summary) {
+      return;
+    }
+    ++summaries_;
+    Emit(Format("DEBUG_SAULO AA838 summary reason=%s frames=%" PRIu64 " aa838_frames=%" PRIu64
+                " draws=%" PRIu64 " draws_per_frame=[0:%" PRIu64 " 1:%" PRIu64 " 2:%" PRIu64
+                " 3:%" PRIu64 " 4:%" PRIu64 " 5+:%" PRIu64 "] stage_a_requested=%" PRIu64
+                " stage_a_bound=%" PRIu64 " dropped=%" PRIu64 " anomalies=%" PRIu64
+                " translations=%" PRIu64 " without_fix=%" PRIu64 " states=%zu",
+                reason, frames_, aa838_frames_, total_draws_, draws_per_frame_[0],
+                draws_per_frame_[1], draws_per_frame_[2], draws_per_frame_[3], draws_per_frame_[4],
+                draws_per_frame_[5], stage_a_requested_, stage_a_bound_, dropped_draws_, anomalies_,
+                translation_count_, translations_without_fix_, signatures_.size()));
+  }
+
+  std::string DrawLine(uint32_t ordinal, const Aa838DrawRecord& r) const {
+    int fix_compiled = FixCompiled(r.ps_modification);
+    return Format(
+        "DEBUG_SAULO AA838 draw frame=%" PRIu64 " ordinal=%u stage=%s ps=%016" PRIX64
+        " mod=%016" PRIX64
+        " stage_a_bool=%d uploaded=%d guest_b120=%d fix=%s reached=%s"
+        " rov=%d msaa=guest%u/host%u scale=%ux%u color=base%u/fmt%u depth=base%u/fmt%u"
+        " pitch=%u host_rt=bits%X/c0fmt%u/dfmt%u mask=%08X blend=%08X depthctl=%08X"
+        " stencil=%08X/%08X vp=%u,%u,%ux%u sc=%u,%u,%ux%u src=tf%d@%08X/fmt%u/%ux%u"
+        " prim=%u/%u",
+        r.frame, ordinal, StageName(ordinal), r.ps_hash, r.ps_modification,
+        int(r.stage_a_requested), int(r.bool_bound), int(r.guest_bool),
+        fix_compiled < 0 ? "?" : (fix_compiled ? "1" : "0"), ReachedName(r.reached), int(r.rov),
+        r.guest_msaa_samples, r.host_msaa_samples, r.resolution_scale_x, r.resolution_scale_y,
+        r.color_base, r.color_format, r.depth_base, r.depth_format, r.surface_pitch, r.host_rt_bits,
+        r.host_rt0_format, r.host_depth_format, r.color_mask, r.blend_control, r.depth_control,
+        r.stencil_ref_mask, r.stencil_ref_mask_bf, r.viewport[0], r.viewport[1], r.viewport[2],
+        r.viewport[3], r.scissor[0], r.scissor[1], r.scissor[2], r.scissor[3],
+        r.source_fetch == UINT32_MAX ? -1 : int(r.source_fetch), r.source_address, r.source_format,
+        r.source_width, r.source_height, r.primitive_type, r.index_count);
+  }
+
+  Sink sink_;
+  mutable std::mutex mutex_;
+  std::map<const char*, uint32_t> anomaly_kind_lines_;
+  std::map<uint64_t, bool> translations_;
+  std::vector<uint64_t> signatures_;
+  std::vector<std::pair<uint32_t, Aa838DrawRecord>> frame_records_;
+  uint64_t frame_signature_ = kFnvOffset;
+  uint32_t frame_draws_ = 0;
+  uint32_t frame_stage_a_ = 0;
+  bool frame_anomaly_ = false;
+  bool flushed_ = false;
+  bool device_logged_ = false;
+  uint64_t frames_ = 0;
+  uint64_t aa838_frames_ = 0;
+  uint64_t total_draws_ = 0;
+  uint64_t draws_per_frame_[6] = {};
+  uint64_t stage_a_requested_ = 0;
+  uint64_t stage_a_bound_ = 0;
+  uint64_t dropped_draws_ = 0;
+  uint64_t anomalies_ = 0;
+  uint64_t translation_count_ = 0;
+  uint64_t translations_without_fix_ = 0;
+  uint64_t lines_emitted_ = 0;
+  uint32_t anomaly_lines_ = 0;
+  uint32_t anomaly_frames_logged_ = 0;
+  uint32_t new_signature_frames_ = 0;
+  uint32_t periodic_frames_ = 0;
+  uint32_t summaries_ = 0;
+  uint32_t translation_lines_ = 0;
+};
+
+DebugSauloAa838Telemetry& DebugSauloAa838TelemetryInstance();
+
+}  // namespace rex::graphics::d3d12
