+// Titles tell a stored title-specific setting (source 2) from an unset one (source 1, default).
+uint32_t ProfileSettingSource(const UserProfile::Setting* setting) {
+  if (!setting) {
+    return 0;
+  }
+  if (!setting->is_title_specific()) {
+    return setting->is_set ? 1 : 0;
+  }
+  const bool empty_binary =
+      setting->type == UserProfile::Setting::Type::BINARY &&
+      static_cast<const UserProfile::BinarySetting*>(setting)->value.empty();
+  return setting->is_set && !empty_binary ? 2 : 1;
+}
