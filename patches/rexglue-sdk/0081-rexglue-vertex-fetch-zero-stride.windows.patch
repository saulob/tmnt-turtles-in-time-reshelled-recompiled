+namespace {
+
+// Logs the first vertex fetch that reuses a binding with a different, non-zero stride than the
+// one the binding was created with. Each attribute is addressed with its own stride, so this is
+// not fatal, but it is unexpected and worth a one-shot warning.
+void WarnMixedStrideVertexFetch(const Shader& shader, const ParsedVertexFetchInstruction& fetch_instr,
+                                uint32_t fetch_constant, uint32_t binding_stride) {
+  static std::atomic<bool> warned{false};
+  if (warned.exchange(true, std::memory_order_relaxed)) {
+    return;
+  }
+  REXGPU_WARN(
+      "Vertex fetch constant {} used with stride {}, binding already has stride {} (shader "
+      "hash={:016X})",
+      fetch_constant, fetch_instr.attributes.stride, binding_stride, shader.ucode_data_hash());
+}
+
+}  // namespace
