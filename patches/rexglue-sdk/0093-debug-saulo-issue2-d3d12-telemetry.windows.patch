+// DEBUG_SAULO: issue #2 telemetry (patch 0093).
+void D3D12RenderTargetCache::DebugSauloIssue2Resolve(const draw_util::ResolveInfo& resolve_info,
+                                                     uint32_t copy_shader,
+                                                     uint32_t texture_copy_result,
+                                                     uint32_t texture_copy_count) {
+  debug_saulo_issue2::Counters& c = debug_saulo_issue2::counters;
+  bool depth = resolve_info.IsCopyingDepth();
+  const draw_util::ResolveEdramInfo& edram =
+      depth ? resolve_info.depth_edram_info : resolve_info.color_edram_info;
+  ++c.resolves;
+  if (edram.msaa_samples != xenos::MsaaSamples::k1X) {
+    ++c.msaa_resolves;
+  }
+  if (texture_copy_count) {
+    ++c.texture_copy_resolves;
+  }
+  uint32_t width = resolve_info.coordinate_info.width_div_8 * 8;
+  uint32_t height = resolve_info.height_div_8 * 8;
+  uint32_t signature = edram.packed ^ (width << 16 | height) * 2654435761u ^
+                      (copy_shader << 24 | texture_copy_result << 16 |
+                       resolve_info.copy_dest_info.value);
+  if (!debug_saulo_issue2::FirstResolveSignature(signature)) {
+    return;
+  }
+  uint32_t guest_samples = UINT32_C(1) << uint32_t(edram.msaa_samples);
+  uint32_t host_samples =
+      edram.msaa_samples == xenos::MsaaSamples::k2X && !msaa_2x_supported() ? 4 : guest_samples;
+  REXGPU_WARN(
+      "DEBUG_SAULO ISSUE2 resolve depth={} format={} guest_msaa={} host_msaa={} edram_base={} "
+      "pitch_tiles={} size={}x{} host_size={}x{} copy_shader={} texture_copy={} copies={} "
+      "dest_info={:08X}",
+      depth, uint32_t(edram.format), guest_samples, host_samples, uint32_t(edram.base_tiles),
+      uint32_t(edram.pitch_tiles), width, height, width * draw_resolution_scale_x(),
+      height * draw_resolution_scale_y(), copy_shader, texture_copy_result, texture_copy_count,
+      resolve_info.copy_dest_info.value);
+}
