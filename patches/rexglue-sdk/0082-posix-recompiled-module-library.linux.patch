On Linux, loads the recompiled shared library of a module (the secondary XEX of a title) from lib<name>.so beside the
executable. The code generator names the library <project>_<module> for LoadLibrary, which completes the .dll
suffix itself; dlopen does not complete a prefix or suffix, so the module never loaded.

diff --git a/src/system/kernel_state.cpp b/src/system/kernel_state.cpp
--- a/src/system/kernel_state.cpp
+++ b/src/system/kernel_state.cpp
@@ -16,6 +16,7 @@
 
 #include <fmt/format.h>
 #include <rex/assert.h>
+#include <rex/filesystem.h>
 #include <rex/image_info.h>
 #include <rex/logging.h>
 #include <rex/math.h>
@@ -47,6 +48,25 @@ namespace rex::system {
 
 constexpr uint32_t kDeferredOverlappedDelayMillis = 100;
 
+namespace {
+
+// dlopen does not add the "lib" prefix and ".so" suffix that LoadLibrary completes a name with, so the library the
+// code generator named <project>_<module> is the lib<project>_<module>.so beside the executable.
+std::filesystem::path RecompiledModuleLibraryPath(const std::string& shared_lib_name) {
+  const std::filesystem::path name(shared_lib_name);
+  if (name.has_parent_path() || name.extension() == ".so") {
+    return name;
+  }
+  std::error_code ec;
+  auto beside_executable = rex::filesystem::GetExecutableFolder() / ("lib" + shared_lib_name + ".so");
+  if (std::filesystem::exists(beside_executable, ec)) {
+    return beside_executable;
+  }
+  return name;
+}
+
+}  // namespace
+
 // This is a global object initialized with the XboxkrnlModule.
 // It references the current kernel state object that all kernel methods should
 // be using to stash their variables.
@@ -759,7 +779,7 @@ object_ref<UserModule> KernelState::LoadUserModule(const std::string_view raw_na
