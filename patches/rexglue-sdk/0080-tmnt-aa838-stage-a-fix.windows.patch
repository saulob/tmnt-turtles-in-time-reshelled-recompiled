+// AA838 is the Xenos interleaved-copy pixel shader TMNT uses to merge the turtle G-buffer.
+// Forcing its packed output byte 1 (oC0.g) to 0 on the frame's first AA838 draw (Stage A) fixes
+// the production cyan/blue turtle flicker; see Aa838StageAFix and
+// DxbcShaderTranslator::ApplyAa838StageAFix.
+constexpr uint64_t kAa838InterleavedCopyPixelShader = 0xAA83877EDB2163EEull;
+// Bool constant slot carrying the Stage A classification into the shader, clear of the guest's
+// own bool constants.
+constexpr uint32_t kAa838StageAByte1ZeroBool = 120;
+
 #define XE_GPU_FINE_GRAINED_DRAW_SCOPES 1
