+void D3D12CommandProcessor::DebugSauloIssue2Draw(const D3D12Shader* vertex_shader, uint64_t ps_hash,
+                                                 bool stage_a) {
+  if (ps_hash != kAa838InterleavedCopyPixelShader) {
+    return;
+  }
+  DebugSauloIssue2State& s = debug_saulo_issue2_;
+  uint32_t ordinal = s.aa838_draws_in_frame++;
+  ++s.aa838_draws;
+  const RegisterFile& regs = *register_file_;
+  uint32_t vfetch_index = UINT32_MAX;
+  const Shader::ConstantRegisterMap& map = vertex_shader->constant_register_map();
+  for (uint32_t i = 0; i < rex::countof(map.vertex_fetch_bitmap) && vfetch_index == UINT32_MAX; ++i) {
+    uint32_t bit;
+    if (rex::bit_scan_forward(map.vertex_fetch_bitmap[i], &bit)) {
+      vfetch_index = i * 32 + bit;
+    }
+  }
+  xenos::xe_gpu_vertex_fetch_t vfetch = {};
+  if (vfetch_index != UINT32_MAX) {
+    vfetch = regs.GetVertexFetch(vfetch_index);
+  }
+  const uint32_t state[] = {
+      regs[XE_GPU_REG_RB_SURFACE_INFO],         regs[XE_GPU_REG_RB_COLOR_INFO],
+      regs[XE_GPU_REG_RB_DEPTH_INFO],           regs[XE_GPU_REG_RB_COLOR_MASK],
+      regs[XE_GPU_REG_RB_DEPTHCONTROL],         regs[XE_GPU_REG_PA_SC_WINDOW_SCISSOR_TL],
+      regs[XE_GPU_REG_PA_SC_WINDOW_SCISSOR_BR], regs[XE_GPU_REG_PA_CL_VPORT_XSCALE],
+      regs[XE_GPU_REG_PA_CL_VPORT_XOFFSET],     regs[XE_GPU_REG_PA_CL_VPORT_YSCALE],
+      regs[XE_GPU_REG_PA_CL_VPORT_YOFFSET],     regs[XE_GPU_REG_SHADER_CONSTANT_BOOL_096_127],
+      vfetch.dword_0,                           vfetch.dword_1};
+  uint32_t signature = 2166136261u;
+  for (uint32_t value : state) {
+    signature = (signature ^ value) * 16777619u;
+  }
+  bool first_frames = s.aa838_frames < 3;
+  bool changed = ordinal < 4 && s.aa838_signatures[ordinal] != signature;
+  if (ordinal < 4) {
+    s.aa838_signatures[ordinal] = signature;
+  }
+  if ((first_frames || changed) && s.aa838_draw_logs < 48) {
+    ++s.aa838_draw_logs;
+    REXGPU_WARN(
+        "DEBUG_SAULO ISSUE2 AA838 draw frame={} ordinal={} stage_a={} vs={:016X} surface={:08X} "
+        "color0={:08X} depth={:08X} color_mask={:08X} depth_control={:08X} scissor={:08X}-{:08X} "
+        "viewport=({},{},{},{}) bools_96_127={:08X} vfetch{}={:08X}:{:08X}",
+        s.frame, ordinal, stage_a, vertex_shader->ucode_data_hash(), state[0], state[1], state[2],
+        state[3], state[4], state[5], state[6], regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_XSCALE),
+        regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_XOFFSET),
+        regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_YSCALE),
+        regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_YOFFSET), state[11], vfetch_index, state[12],
+        state[13]);
+  }
+}
+
+void D3D12CommandProcessor::DebugSauloIssue2PipelineSkip(const void* pipeline_handle,
+                                                         uint64_t vs_hash, uint64_t ps_hash,
+                                                         xenos::PrimitiveType primitive_type,
+                                                         uint32_t index_count) {
+  DebugSauloIssue2State& s = debug_saulo_issue2_;
+  ++s.pipeline_skips;
+  bool character = debug_saulo_issue2::IsCharacterPixelShader(ps_hash);
+  if (character) {
+    ++s.character_pipeline_skips;
+    if (s.pipeline_skip_logs < debug_saulo_issue2::kLogLimit) {
+      ++s.pipeline_skip_logs;
+      REXGPU_WARN(
+          "DEBUG_SAULO ISSUE2 pipeline skip frame={} vs={:016X} ps={:016X} prim={} count={}",
+          s.frame, vs_hash, ps_hash, uint32_t(primitive_type), index_count);
+    }
+  }
+  auto it = s.pending_pipelines.find(pipeline_handle);
+  if (it == s.pending_pipelines.end()) {
+    if (s.pending_pipelines.size() < 4096) {
+      s.pending_pipelines.emplace(pipeline_handle, DebugSauloIssue2State::PendingPipeline{s.frame, false});
+    }
+    return;
+  }
+  if (!it->second.reported &&
+      s.frame - it->second.first_frame >= debug_saulo_issue2::kStuckPipelineFrames &&
+      s.pipeline_stuck_logs < debug_saulo_issue2::kLogLimit) {
+    it->second.reported = true;
+    ++s.pipeline_stuck_logs;
+    REXGPU_WARN(
+        "DEBUG_SAULO ISSUE2 pipeline stuck frame={} since={} vs={:016X} ps={:016X} character={}",
+        s.frame, it->second.first_frame, vs_hash, ps_hash, character);
+  }
+}
+
+void D3D12CommandProcessor::DebugSauloIssue2EndFrame() {
+  DebugSauloIssue2State& s = debug_saulo_issue2_;
+  if (s.aa838_draws_in_frame) {
+    ++s.aa838_frames;
+    if (s.aa838_draws_in_frame != 3) {
+      ++s.aa838_odd_frames;
+      if (s.aa838_count_logs < debug_saulo_issue2::kLogLimit) {
+        ++s.aa838_count_logs;
+        REXGPU_WARN("DEBUG_SAULO ISSUE2 AA838 count frame={} draws={} expected=3", s.frame,
+                    s.aa838_draws_in_frame);
+      }
+    }
+  }
+  s.aa838_draws_in_frame = 0;
+  ++s.frame;
+  const debug_saulo_issue2::Counters& c = debug_saulo_issue2::counters;
+  uint64_t events = s.aa838_odd_frames + s.pipeline_skips + c.render_targets_created + c.resolves;
+  if (s.frame - s.summary_frame < debug_saulo_issue2::kSummaryFrames || events == s.summary_events) {
+    return;
+  }
+  s.summary_frame = s.frame;
+  s.summary_events = events;
+  REXGPU_WARN(
+      "DEBUG_SAULO ISSUE2 summary frame={} aa838_draws={} aa838_frames={} aa838_odd_frames={} "
+      "pipeline_skips={} character_pipeline_skips={} pending_pipelines={} render_targets={} "
+      "resolves={} msaa_resolves={} texture_copy_resolves={}",
+      s.frame, s.aa838_draws, s.aa838_frames, s.aa838_odd_frames, s.pipeline_skips,
+      s.character_pipeline_skips, s.pending_pipelines.size(), c.render_targets_created, c.resolves,
+      c.msaa_resolves, c.texture_copy_resolves);
+}
