+// DEBUG_SAULO: issue #2 telemetry (patch 0093). Logged as warnings so compact logs keep it.
+void D3D12CommandProcessor::DebugSauloIssue2Config(uint32_t frontbuffer_width,
+                                                  uint32_t frontbuffer_height) {
+  if (debug_saulo_issue2_.config_logged) {
+    return;
+  }
+  debug_saulo_issue2_.config_logged = true;
+  uint32_t scale_x = render_target_cache_->draw_resolution_scale_x();
+  uint32_t scale_y = render_target_cache_->draw_resolution_scale_y();
+  bool rov = render_target_cache_->GetPath() == RenderTargetCache::Path::kPixelShaderInterlock;
+  bool native_2x = render_target_cache_->msaa_2x_supported();
+  REXGPU_WARN(
+      "DEBUG_SAULO ISSUE2 config guest={}x{} host={}x{} scale={}x{} path={} guest_2x_msaa_host={} "
+      "msaa_mode={} post_effect={} anisotropic={} vendor=0x{:04X} async_compile={}",
+      frontbuffer_width, frontbuffer_height, frontbuffer_width * scale_x,
+      frontbuffer_height * scale_y, scale_x, scale_y, rov ? "rov" : "rtv", native_2x ? 2 : 4,
+      native_2x ? "native" : "compatibility", REXCVAR_GET(swap_post_effect),
+      REXCVAR_GET(anisotropic_override), uint32_t(GetD3D12Provider().GetAdapterVendorID()),
+      REXCVAR_GET(async_shader_compilation));
+}
