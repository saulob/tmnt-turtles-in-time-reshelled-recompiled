 // The panel drawn over a border softens one pixel of it.
 inline float PanelBorderWidth(float scale) { return LineThickness(scale) + 1.0f; }
 
+// A host that renders ImGui in a logical coordinate space supplies render_scale (physical pixels per
+// coordinate) so that strokes and icon origins snap to the pixels the renderer will actually use.
+inline float SnapDown(float value, float pixel_scale) {
+  return pixel_scale > 0.0f ? std::floor(value * pixel_scale) / pixel_scale : value;
+}
+inline float SnapUp(float value, float pixel_scale) {
+  return pixel_scale > 0.0f ? std::ceil(value * pixel_scale) / pixel_scale : value;
+}
+inline float SnapNearest(float value, float pixel_scale) {
+  return pixel_scale > 0.0f ? std::floor(value * pixel_scale + 0.5f) / pixel_scale : value;
+}
+inline float PixelLineThickness(float scale, float pixel_scale) {
+  return LineThickness(scale * pixel_scale) / pixel_scale;
+}
+inline float PixelPassiveLineThickness(float scale, float pixel_scale) {
+  return PassiveLineThickness(scale * pixel_scale) / pixel_scale;
+}
+inline float PixelPanelBorderWidth(float scale, float pixel_scale) {
+  return PanelBorderWidth(scale * pixel_scale) / pixel_scale;
+}
+// The reference's unrounded minimum stroke: 1 physical pixel, or `scale` physical pixels if larger.
+inline float PixelMaxLineWidth(float scale, float pixel_scale) {
+  return std::max(1.0f, scale * pixel_scale) / pixel_scale;
+}
+
 // A page's width with room for its scrollbar, so that the bar appearing moves nothing.
 inline float StableContentWidth(float body_width, float scrollbar_size) { return body_width - scrollbar_size; }
 
