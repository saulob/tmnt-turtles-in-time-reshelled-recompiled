+/**
+ * @modified    Tom Clay, 2026 - Adapted for ReXGlue runtime
+ */
+
+#pragma once
+
+#include <cstdint>
+
+namespace rex::graphics::d3d12 {
+
+// Classifies the AA838 interleaved-copy draws of the current frame into Stage A, B and C by
+// draw order, the only reliable signature (the source address repeats across stages). Stage A
+// is the one whose packed output byte 1 must be forced to 0; see kAa838InterleavedCopyPixelShader
+// and DxbcShaderTranslator::ApplyAa838StageAFix.
+class Aa838StageAFix {
+ public:
+  void OnFrameEnd() { frame_ordinal_ = 0; }
+
+  // Call exactly once per issued draw, in draw order. ps_hash is the pixel shader's ucode hash
+  // for this draw, or 0 if there is none. Returns whether this draw is AA838 Stage A.
+  bool OnDraw(uint64_t ps_hash);
+
+ private:
+  uint32_t frame_ordinal_ = 0;
+};
+
+}  // namespace rex::graphics::d3d12
