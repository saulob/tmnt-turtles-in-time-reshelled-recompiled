 namespace {
 constexpr std::chrono::milliseconds kWorkerShutdownTimeout{500};
+constexpr std::chrono::milliseconds kCallbackExitTimeout{500};
+constexpr int kNoClient = -1;
+
+// At file scope so the class layout the exe compiles against stays stock.
+std::atomic<int> g_running_client{kNoClient};
+std::atomic<std::thread::id> g_worker_thread{};
+
+// False when the wait timed out. The worker cannot wait for itself: a callback may unregister its own client.
+bool WaitForCallbackExit(int index) {
+  if (std::this_thread::get_id() == g_worker_thread.load()) {
+    return true;
+  }
+  const auto deadline = std::chrono::steady_clock::now() + kCallbackExitTimeout;
+  while (g_running_client.load() == index) {
+    if (std::chrono::steady_clock::now() >= deadline) {
+      return false;
+    }
+    rex::thread::Sleep(std::chrono::milliseconds(1));
+  }
+  return true;
+}
 }  // namespace
 
