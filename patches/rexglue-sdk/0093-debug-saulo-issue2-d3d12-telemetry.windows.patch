@@ -0,0 +1,52 @@
+/**
+ * @modified    Tom Clay, 2026 - Adapted for ReXGlue runtime
+ */
+
+// DEBUG_SAULO: temporary telemetry for issue #2 (patch 0093); remove or retain deliberately before a final release.
+#pragma once
+
+#include <cstdint>
+
+#include <rex/graphics/flags.h>
+
+namespace rex::graphics::d3d12::debug_saulo_issue2 {
+
+inline constexpr uint32_t kLogLimit = 32;
+inline constexpr uint64_t kSummaryFrames = 600;
+inline constexpr uint64_t kStuckPipelineFrames = 300;
+
+// Only the GPU command processor thread touches these.
+struct Counters {
+  uint64_t render_targets_created = 0;
+  uint64_t resolves = 0;
+  uint64_t msaa_resolves = 0;
+  uint64_t texture_copy_resolves = 0;
+  uint32_t render_target_logs = 0;
+  uint32_t resolve_logs = 0;
+  uint32_t resolve_signatures[kLogLimit] = {};
+};
+inline Counters counters;
+
+// The turtle G-buffer and light passes and AA838, from the issue #2 and flicker investigations.
+inline bool IsCharacterPixelShader(uint64_t hash) {
+  return hash == kAa838InterleavedCopyPixelShader || hash == 0x47184C4711FA376Bull ||
+         hash == 0x22B8B02BC0941969ull || hash == 0x8900D5C1DE5429FDull ||
+         hash == 0xB38650489C3D4F85ull || hash == 0xCF897CBD86E65AC4ull;
+}
+
+// Returns whether a resolve with this signature is logged: the first kLogLimit distinct ones.
+inline bool FirstResolveSignature(uint32_t signature) {
+  Counters& c = counters;
+  for (uint32_t i = 0; i < c.resolve_logs; ++i) {
+    if (c.resolve_signatures[i] == signature) {
+      return false;
+    }
+  }
+  if (c.resolve_logs >= kLogLimit) {
+    return false;
+  }
+  c.resolve_signatures[c.resolve_logs++] = signature;
+  return true;
+}
+
+}  // namespace rex::graphics::d3d12::debug_saulo_issue2
