+void DxbcShaderTranslator::EmitShredderTintConstantFetch(const dxbc::Src& fetch_constant_src,
+                                                         const dxbc::Dest& address_dest) {
+  uint32_t bool_test_temp = PushSystemTemp();
+  if (cbuffer_index_bool_loop_constants_ == kBindingIndexUnallocated) {
+    cbuffer_index_bool_loop_constants_ = cbuffer_count_++;
+  }
+  a_.OpAnd(dxbc::Dest::R(bool_test_temp, 0b0001),
+           dxbc::Src::CB(cbuffer_index_bool_loop_constants_,
+                         uint32_t(CbufferRegister::kBoolLoopConstants),
+                         d3d12::kShredderTintFixBool >> 7)
+               .Select((d3d12::kShredderTintFixBool >> 5) & 3),
+           dxbc::Src::LU(UINT32_C(1) << (d3d12::kShredderTintFixBool & 31)));
+  a_.OpIf(true, dxbc::Src::R(bool_test_temp, dxbc::Src::kXXXX));
+  PopSystemTemp();
+  a_.OpAnd(address_dest, fetch_constant_src.SelectFromSwizzled(0), dxbc::Src::LU(~uint32_t(3)));
+  a_.OpEndIf();
+}
