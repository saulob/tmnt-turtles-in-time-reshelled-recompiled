+// From the top of a line to the middle of its capitals, which is where the eye puts the text's centre.
+float CapCenter(ImFont* font, float size) {
+  const ImFontGlyph* glyph = font->GetFontBaked(size)->FindGlyph('H');
+  return glyph ? (glyph->Y0 + glyph->Y1) * 0.5f : size * 0.5f;
+}
+
+// Draws the shortcuts as keycaps and labels centred on `at.y`, or only measures them without `dl`.
+float DrawKeyHints(ImDrawList* dl, const std::vector<layout::KeyHint>& hints, const Fonts& fonts, const Theme& t,
+                   ImVec2 at, float s) {
+  const float size = layout::kTextFooter * s;
+  const float cap_h = layout::kKeycapHeight * s, padding = layout::kKeycapPadding * s;
+  const float cap_top = std::floor(at.y - cap_h * 0.5f);
+  const float key_top = layout::CenteredTop(at.y, CapCenter(fonts.semibold, size));
+  const float action_top = layout::CenteredTop(at.y, CapCenter(fonts.regular, size));
+  float x = at.x;
+  for (const layout::KeyHint& hint : hints) {
+    const char* key_end = hint.key.data() + hint.key.size();
+    const char* action_end = hint.action.data() + hint.action.size();
+    if (!hint.key.empty()) {
+      const float text_w = fonts.semibold->CalcTextSizeA(size, FLT_MAX, 0.0f, hint.key.data(), key_end).x;
+      const float cap_w = std::floor(text_w + padding * 2);
+      if (dl) {
+        const ImVec2 min(std::floor(x), cap_top), max(min.x + cap_w, cap_top + cap_h);
+        const float rounding = layout::kKeycapRounding * s;
+        dl->AddRectFilled(min, max, Col(t.frame, 0.7f), rounding);
+        dl->AddRect(min, max, Col(t.frame_hot), rounding, 0, layout::LineThickness(s));
+        dl->AddText(fonts.semibold, size, ImVec2(min.x + (cap_w - text_w) * 0.5f, key_top), Col(t.text),
+                    hint.key.data(), key_end);
+      }
+      x += cap_w + layout::kKeycapGap * s;
+    }
+    if (dl) dl->AddText(fonts.regular, size, ImVec2(x, action_top), Col(t.text, 0.85f), hint.action.data(), action_end);
+    x += fonts.regular->CalcTextSizeA(size, FLT_MAX, 0.0f, hint.action.data(), action_end).x;
+    x += layout::kKeyHintGap * s;
+  }
+  return hints.empty() ? 0.0f : x - at.x - layout::kKeyHintGap * s;
+}
