+// DEBUG_SAULO: temporary Steam Deck telemetry (issue #3); remove with patch 0092.
+namespace {
+constexpr uint32_t kDebugSauloLogLimit = 24;
+constexpr uint64_t kDebugSauloSummaryFrames = 600;
+uint64_t DebugSauloHash(const Shader* shader) { return shader ? shader->ucode_data_hash() : 0; }
+}  // namespace
+
+void VulkanCommandProcessor::DebugSauloPlaceholderDraw(const Shader* vertex_shader,
+                                                       const Shader* pixel_shader,
+                                                       xenos::PrimitiveType prim_type,
+                                                       uint32_t index_count) {
+  ++debug_saulo_.placeholder_draws;
+  if (!debug_saulo_.placeholder_draws_in_frame++) {
+    ++debug_saulo_.placeholder_frames;
+  }
+  if (debug_saulo_.placeholder_draws_logged < kDebugSauloLogLimit) {
+    ++debug_saulo_.placeholder_draws_logged;
+    REXGPU_INFO(
+        "DEBUG_SAULO placeholder draw skipped: frame {} VS {:016X} PS {:016X} prim {} count {}",
+        debug_saulo_.frame, DebugSauloHash(vertex_shader), DebugSauloHash(pixel_shader),
+        uint32_t(prim_type), index_count);
+  }
+}
+
+void VulkanCommandProcessor::DebugSauloStaleVertexBuffer(uint32_t vfetch_index,
+                                                         uint32_t address_dwords,
+                                                         uint32_t size_dwords,
+                                                         const Shader* vertex_shader,
+                                                         const Shader* pixel_shader) {
+  ++debug_saulo_.stale_vertex_skips;
+  if (debug_saulo_.stale_vertex_logged < kDebugSauloLogLimit) {
+    ++debug_saulo_.stale_vertex_logged;
+    REXGPU_INFO(
+        "DEBUG_SAULO stale vertex buffer: frame {} vfetch {} address 0x{:08X} size {} VS {:016X} "
+        "PS {:016X}",
+        debug_saulo_.frame, vfetch_index, address_dwords << 2, size_dwords << 2,
+        DebugSauloHash(vertex_shader), DebugSauloHash(pixel_shader));
+  }
+}
+
+void VulkanCommandProcessor::DebugSauloAa838Draw(uint64_t ps_hash, bool stage_a) {
+  if (ps_hash != kAa838InterleavedCopyPixelShader) {
+    return;
+  }
+  ++debug_saulo_.aa838_draws_in_frame;
+  if (stage_a && !debug_saulo_.aa838_stage_a_draws++) {
+    REXGPU_INFO("DEBUG_SAULO AA838 Stage A fix first applied at frame {}", debug_saulo_.frame);
+  }
+}
+
+void VulkanCommandProcessor::DebugSauloEndFrame() {
+  DebugSauloTelemetry& t = debug_saulo_;
+  if (t.aa838_draws_in_frame) {
+    ++t.aa838_frames;
+    if (t.aa838_draws_in_frame != 3 && t.aa838_odd_frames_logged < kDebugSauloLogLimit) {
+      ++t.aa838_odd_frames_logged;
+      REXGPU_INFO("DEBUG_SAULO AA838 frame {} has {} draws, expected 3", t.frame,
+                  t.aa838_draws_in_frame);
+    }
+  }
+  t.aa838_draws_in_frame = 0;
+  t.placeholder_draws_in_frame = 0;
+  ++t.frame;
+  uint64_t events = t.placeholder_draws + t.skipped_presents + t.stale_vertex_skips;
+  if (t.frame - t.summary_frame >= kDebugSauloSummaryFrames && events != t.summary_events) {
+    t.summary_frame = t.frame;
+    t.summary_events = events;
+    REXGPU_INFO(
+        "DEBUG_SAULO Vulkan summary: frame {} | placeholder draws {} in {} frames, presents "
+        "skipped {} | stale vertex buffers {} | AA838 frames {}, Stage A draws {}",
+        t.frame, t.placeholder_draws, t.placeholder_frames, t.skipped_presents,
+        t.stale_vertex_skips, t.aa838_frames, t.aa838_stage_a_draws);
+  }
+}
