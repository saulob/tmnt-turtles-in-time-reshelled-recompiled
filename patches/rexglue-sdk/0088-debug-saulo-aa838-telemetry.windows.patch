+// DEBUG_SAULO: reads the device and both caches, so SetupContext calls it last.
+void D3D12CommandProcessor::DebugSauloAa838LogDevice() {
+  if (!render_target_cache_ || !texture_cache_) {
+    return;
+  }
+  const ui::d3d12::D3D12Provider& provider = GetD3D12Provider();
+  ID3D12Device* device = provider.GetDevice();
+  if (!device) {
+    return;
+  }
+  Aa838DeviceInfo info;
+  IDXGIFactory4* factory = nullptr;
+  if (provider.GetDXGIFactory() &&
+      SUCCEEDED(provider.GetDXGIFactory()->QueryInterface(IID_PPV_ARGS(&factory)))) {
+    IDXGIAdapter1* adapter = nullptr;
+    if (SUCCEEDED(factory->EnumAdapterByLuid(device->GetAdapterLuid(), IID_PPV_ARGS(&adapter)))) {
+      DXGI_ADAPTER_DESC1 desc;
+      if (SUCCEEDED(adapter->GetDesc1(&desc))) {
+        info.vendor_id = desc.VendorId;
+        info.device_id = desc.DeviceId;
+      }
+      LARGE_INTEGER umd_version;
+      if (SUCCEEDED(adapter->CheckInterfaceSupport(__uuidof(IDXGIDevice), &umd_version))) {
+        info.driver_version = uint64_t(umd_version.QuadPart);
+      }
+      adapter->Release();
+    }
+    factory->Release();
+  }
+  static const DXGI_FORMAT kFormats[] = {
+      DXGI_FORMAT_R8G8B8A8_UNORM, DXGI_FORMAT_R10G10B10A2_UNORM, DXGI_FORMAT_D24_UNORM_S8_UINT,
+      DXGI_FORMAT_D32_FLOAT_S8X24_UINT, DXGI_FORMAT_R32_UINT};
+  for (size_t i = 0; i < rex::countof(kFormats); ++i) {
+    for (uint32_t samples : {2u, 4u}) {
+      D3D12_FEATURE_DATA_MULTISAMPLE_QUALITY_LEVELS levels = {};
+      levels.Format = kFormats[i];
+      levels.SampleCount = samples;
+      uint32_t quality = SUCCEEDED(device->CheckFeatureSupport(
+                             D3D12_FEATURE_MULTISAMPLE_QUALITY_LEVELS, &levels, sizeof(levels)))
+                             ? levels.NumQualityLevels
+                             : 0;
+      (samples == 2 ? info.quality_2x : info.quality_4x)[i] = quality;
+    }
+  }
+  info.tiled_resources_tier = uint32_t(provider.GetTiledResourcesTier());
+  info.unaligned_bc = provider.AreUnalignedBlockTexturesSupported();
+  info.sample_positions_tier = uint32_t(provider.GetProgrammableSamplePositionsTier());
+  info.rov_supported = provider.AreRasterizerOrderedViewsSupported();
+  info.bindless = bindless_resources_used_;
+  info.rov = render_target_cache_->GetPath() == RenderTargetCache::Path::kPixelShaderInterlock;
+  info.native_2x_msaa = REXCVAR_GET(native_2x_msaa);
+  info.host_2x = render_target_cache_->msaa_2x_supported();
+  info.resolution_scale_x = texture_cache_->draw_resolution_scale_x();
+  info.resolution_scale_y = texture_cache_->draw_resolution_scale_y();
+  info.async_shader_compilation = REXCVAR_GET(async_shader_compilation);
+  info.depth_f24_in_ps = render_target_cache_->depth_float24_convert_in_pixel_shader();
+  info.depth_f24_round = render_target_cache_->depth_float24_round();
+  info.stage_a_bool = kAa838StageAByte1ZeroBool;
+  info.stage_a_ps = kAa838InterleavedCopyPixelShader;
+  DebugSauloAa838TelemetryInstance().LogDevice(info);
+}
