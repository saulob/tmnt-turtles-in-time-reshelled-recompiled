   PopSystemTemp();
 }
 
+bool DxbcShaderTranslator::IsAa838Shader() const {
+  return is_pixel_shader() && current_shader().ucode_data_hash() == kAa838InterleavedCopyPixelShader &&
+         !current_shader().uses_register_dynamic_addressing() && register_count() >= 2;
+}
+
+void DxbcShaderTranslator::ApplyAa838StageAFix() {
+  if (!IsAa838Shader() || !current_shader().writes_color_target(0)) {
+    return;
+  }
+  uint32_t bool_test_temp = PushSystemTemp();
+  if (cbuffer_index_bool_loop_constants_ == kBindingIndexUnallocated) {
+    cbuffer_index_bool_loop_constants_ = cbuffer_count_++;
+  }
+  a_.OpAnd(dxbc::Dest::R(bool_test_temp, 0b0001),
+           dxbc::Src::CB(cbuffer_index_bool_loop_constants_,
+                         uint32_t(CbufferRegister::kBoolLoopConstants),
+                         kAa838StageAByte1ZeroBool >> 7)
+               .Select((kAa838StageAByte1ZeroBool >> 5) & 3),
+           dxbc::Src::LU(UINT32_C(1) << (kAa838StageAByte1ZeroBool & 31)));
+  a_.OpIf(true, dxbc::Src::R(bool_test_temp, dxbc::Src::kXXXX));
+  PopSystemTemp();
+  a_.OpMov(dxbc::Dest::R(system_temps_color_[0], 0b0010), dxbc::Src::LF(0.0f));
+  a_.OpEndIf();
+}
