+bool SpirvShaderTranslator::IsAa838Shader() const {
+  return is_pixel_shader() && !is_depth_only_fragment_shader_ &&
+         current_shader().ucode_data_hash() == kAa838InterleavedCopyPixelShader &&
+         !current_shader().uses_register_dynamic_addressing() && register_count() >= 2;
+}
+
+void SpirvShaderTranslator::ApplyAa838StageAFix() {
+  // Like the D3D12 fix, only the host render target path; the guest color is still in the
+  // fragment output here, before any later pass reads it.
+  if (edram_fragment_shader_interlock_ || !IsAa838Shader() ||
+      !current_shader().writes_color_target(0) ||
+      output_or_var_fragment_data_[0] == spv::NoResult) {
+    return;
+  }
+  id_vector_temp_.clear();
+  // Bool constants (member 0).
+  id_vector_temp_.push_back(const_int_0_);
+  // 128-bit vector.
+  id_vector_temp_.push_back(builder_->makeIntConstant(int(kAa838StageAByte1ZeroBool >> 7)));
+  // 32-bit scalar of a 128-bit vector.
+  id_vector_temp_.push_back(
+      builder_->makeIntConstant(int((kAa838StageAByte1ZeroBool >> 5) & 3)));
+  spv::Id bool_constant_scalar = builder_->createLoad(
+      builder_->createAccessChain(spv::StorageClassUniform, uniform_bool_loop_constants_,
+                                  id_vector_temp_),
+      spv::NoPrecision);
+  spv::Id stage_a = builder_->createBinOp(
+      spv::OpINotEqual, type_bool_,
+      builder_->createBinOp(
+          spv::OpBitwiseAnd, type_uint_, bool_constant_scalar,
+          builder_->makeUintConstant(UINT32_C(1) << (kAa838StageAByte1ZeroBool & 31))),
+      const_uint_0_);
+  SpirvBuilder::IfBuilder if_stage_a(stage_a, spv::SelectionControlDontFlattenMask, *builder_);
+  id_vector_temp_.clear();
+  id_vector_temp_.push_back(builder_->makeIntConstant(1));
+  builder_->createStore(
+      const_float_0_,
+      builder_->createAccessChain(spv::StorageClassOutput, output_or_var_fragment_data_[0],
+                                  id_vector_temp_));
+  if_stage_a.makeEndIf();
+}
