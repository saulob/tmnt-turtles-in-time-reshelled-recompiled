new file mode 100644
index 0000000..05ab859
--- /dev/null
+++ b/src/graphics/d3d12/aa838_stage_fix.cpp
@@ -0,0 +1,18 @@
+/**
+ * @modified    Tom Clay, 2026 - Adapted for ReXGlue runtime
+ */
+
+#include <rex/graphics/d3d12/aa838_stage_fix.h>
+
+#include <rex/graphics/flags.h>
+
+namespace rex::graphics::d3d12 {
+
+bool Aa838StageAFix::OnDraw(uint64_t ps_hash) {
+  if (ps_hash != kAa838InterleavedCopyPixelShader) {
+    return false;
+  }
+  return frame_ordinal_++ == 0;
+}
+
+}  // namespace rex::graphics::d3d12
